# Gemini Developer API (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Maps Experience agent tools (server only)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MCP_URL=https://mapstools.googleapis.com/mcp

# Maps JavaScript API (restrict this browser key by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SQLite path is relative to prisma/schema.prisma
DATABASE_URL=file:./dev.db
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_MODE=false

# Optional Places API (New) key for structured addresses, ratings and opening hours
GOOGLE_PLACES_API_KEY=
